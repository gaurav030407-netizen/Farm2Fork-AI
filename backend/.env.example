# FastAPI bind settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Required Supabase PostgreSQL SQLAlchemy connection string.
# Keep this in Replit Secrets; never expose it to the React frontend.
SUPABASE_DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173