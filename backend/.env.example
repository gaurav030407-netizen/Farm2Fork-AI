# FastAPI bind settings
BACKEND_HOST=0.0.0.0
PORT=8000
BACKEND_PORT=8000

# Required PostgreSQL connection string shared by the Node API and FastAPI service.
# Keep this in runtime secrets; never expose it to the React frontend.
DATABASE_URL=

# Optional Supabase Storage configuration for crop images only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend-only credential for private Storage uploads and signed URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173

# Node API JWT signing configuration. Keep the real secret in runtime secrets.
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_ALGORITHM=HS256

# Optional TURN configuration, backend-only. Never use these as VITE_* values.
TURN_ICE_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Resend email delivery for account verification. Keep both values backend-only.
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@farm2fork.local

# Government market synchronization. The API key is backend-only; never use a VITE_ variable.
MARKET_DATA_GOV_API_KEY=
MARKET_DATA_CACHE_TTL_SECONDS=1800
MARKET_DATA_MIN_REFRESH_SECONDS=60
MARKET_DATA_RATE_LIMIT_COOLDOWN_SECONDS=300
MARKET_DATA_MAX_COOLDOWN_SECONDS=3600

# Server-side payment gateway configuration. No payment is considered successful without a verified webhook.
PAYMENT_GATEWAY=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# SMS provider configuration is consumed by the Node auth gateway, never by React.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_TEST_MODE=false

# Backend AI service configuration. Never expose these keys to the React frontend.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=1024
AI_MAX_REQUESTS_PER_MINUTE=30

# Local Ollama fallback service configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
