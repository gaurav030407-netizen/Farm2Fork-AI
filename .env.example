# Netlify frontend-safe variables
VITE_API_BASE_URL=https://YOUR-RENDER-NODE-DOMAIN
VITE_WS_BASE_URL=wss://YOUR-RENDER-NODE-DOMAIN/ws/calls

# Render Node API variables (server-side only)
DATABASE_URL=
JWT_SECRET=
JWT_ALGORITHM=HS256
FRONTEND_ORIGINS=https://YOUR-NETLIFY-SITE.netlify.app
FASTAPI_INTERNAL_URL=https://YOUR-RENDER-FASTAPI-DOMAIN
TURN_ICE_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Server-side SMS OTP provider. Leave empty until a supported transport is configured.
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=
SMS_TEST_MODE=false

# Server-side payment gateway. Webhook signatures are mandatory for payment success.
PAYMENT_GATEWAY=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Backend-only Admin bootstrap credentials. Never expose these as VITE_* values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@farm2fork.local

# Render FastAPI variables (server-side only)
# Use the same database/JWT/origin values as the Node service.
